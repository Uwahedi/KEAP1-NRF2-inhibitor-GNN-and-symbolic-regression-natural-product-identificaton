def calculate_distance(atom1, atom2):
    """
    Calculate Euclidean distance between two atoms.
    Parameters
    ----------
    atom1 : tuple
    atom2 : tuple
    Returns
    -------
    float
    """
    return math.sqrt(
        sum(
            (a - b) ** 2
            for a, b in zip(atom1, atom2)
        )
    )

