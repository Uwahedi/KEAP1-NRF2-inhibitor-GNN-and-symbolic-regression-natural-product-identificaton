with open(
    OUTPUT_FOLDER /
    "Symbolic_Regression_Model_Summary.txt",
    "w",
    encoding="utf-8"
) as f:

    f.write(summary)


# =============================================================================
# 27. FINAL CONSOLE SUMMARY
# =============================================================================

logger.info("=" * 80)
logger.info("ANALYSIS COMPLETED")
logger.info("=" * 80)

logger.info(f"Dataset size       : {len(df)}")
logger.info(f"Training R²        : {training_r2:.3f}")
logger.info(f"LOOCV R²           : {cv_r2:.3f}")
logger.info(f"LOOCV RMSE         : {cv_rmse:.3f}")
logger.info(f"LOOCV MAE          : {cv_mae:.3f}")

logger.info(
