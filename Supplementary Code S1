def get_chains_sorted_by_length(structure):
    """
    Return chains sorted according to residue count.
    Parameters
    ----------
    structure : Bio.PDB.Structure
    Returns
    -------
    list
        Chains ordered from longest to shortest.
    """
    model = structure[0]
    chains = list(model.get_chains())
    chains.sort(
        key=lambda chain: len(list(chain.get_residues())),
        reverse=True
    )
    return chains
def get_interface_residues(
    structure,
    receptor_chain_id,
    peptide_chain_id,
    cutoff=DISTANCE_CUTOFF
):
   """
    Identify receptor residues located within the specified cutoff
    distance from the peptide.
    Parameters
    ----------
    structure : Bio.PDB.Structure
    receptor_chain_id : str
    peptide_chain_id : str
    cutoff : float
    Returns
    -------
    list
        Sorted list of interface residues.
   """
    model = structure[0]
    receptor = model[receptor_chain_id]
    peptide = model[peptide_chain_id]
    peptide_atoms = list(peptide.get_atoms())
    neighbor_search = NeighborSearch(peptide_atoms)
    interface = set()
    logger.info(
       f"Scanning interface "
        f"(Chain {receptor_chain_id} vs Chain {peptide_chain_id})"
    )
    for residue in receptor:
        if residue.get_resname() == "HOH":
           continue
        contact = False
        for atom in residue:
            neighbours = neighbor_search.search(
                atom.coord,
                cutoff,
                level="A"
            )
            if neighbours:
                contact = True
               break
        if contact:
            interface.add(
                (
                    residue.get_resname(),
                    residue.get_id()[1]
                )
            )
    return sorted(
        interface,
        key=lambda x: x[1]
    )
